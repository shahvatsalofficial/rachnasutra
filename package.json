{
  "name": "rachnasutra",
  "version": "0.2.0",
  "description": "RachnaSutra AI: open-source UI/UX design, accessibility and responsive audit agent skills for Claude Code, Cursor, Codex, Copilot and Gemini CLI, plus an evidence-first, keyless CLI.",
  "keywords": [
    "ui-ux",
    "ux-audit",
    "accessibility",
    "wcag",
    "wcag-2-2",
    "a11y",
    "design-system",
    "design-tokens",
    "responsive-design",
    "ai-agents",
    "agent-skills",
    "claude-code",
    "cursor",
    "codex",
    "github-copilot",
    "gemini-cli",
    "sarif",
    "cli"
  ],
  "license": "Apache-2.0",
  "author": "Vatsal Shah",
  "homepage": "https://github.com/shahvatsalofficial/rachnasutra#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shahvatsalofficial/rachnasutra.git"
  },
  "bugs": {
    "url": "https://github.com/shahvatsalofficial/rachnasutra/issues"
  },
  "type": "module",
  "bin": {
    "rachnasutra": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "templates",
    "schemas",
    "docs",
    "assets/logo.svg",
    "benchmarks",
    "case-studies",
    "documents/rachnasutra/*.md",
    "fixtures",
    "examples",
    "samples",
    "README.md",
    "LICENSE",
    "NOTICE",
    "AGENTS.md",
    "CLAUDE.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "ROADMAP.md",
    "CITATION.cff",
    "llms.txt",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test",
    "verify": "npm run build && node dist/cli.js verify",
    "docs": "node scripts/build-docs.mjs",
    "samples": "npm run build && node dist/cli.js audit fixtures/intentionally-broken-ui --format json,md,html,sarif --out samples/broken-ui && node dist/cli.js audit fixtures/good-ui --format json,md,html --out samples/good-ui && node scripts/sanitize-paths.mjs samples",
    "examples": "npm run build && node scripts/gen-rule-examples.mjs",
    "prepare": "npm run build",
    "prepublishOnly": "npm test && npm run verify"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
